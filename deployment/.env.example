# Production Environment Variables for Ape Iskole
# Copy this to .env on the Droplet and fill in the values

# --- DOMAIN ---
DOMAIN=apeiskole.lk
FRONTEND_URL=https://ape-iskole-frontend.ondigitalocean.app

# --- POSTGRES ---
POSTGRES_DB=apeiskole
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_db_password

# --- BACKEND ---
# Authority must match the public URL of Keycloak
KEYCLOAK_AUTHORITY=https://apeiskole.lk/auth/realms/apeiskole
DB_CONNECTION_STRING="Host=db;Database=apeiskole;Username=admin;Password=your_secure_db_password"
CORS_ORIGINS="https://apeiskole.lk"

# --- KEYCLOAK ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=your_secure_keycloak_admin_password
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://db:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=your_secure_keycloak_db_password
KC_HOSTNAME=https://apeiskole.lk/auth

# --- PGADMIN ---
PGADMIN_DEFAULT_EMAIL=sithum@example.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password
